<Window x:Class="Практическая_работа_4_Новиков_Соболенко.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа 4. Вариант 5"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#D0D8E8"/>
            <Setter Property="BorderBrush" Value="#7090C0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#4070C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8EEF8" BorderBrush="#B0C0D8" BorderThickness="0,0,0,2" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnNav1"
                        Content="📐 Задание 1 — Линейный алгоритм"
                        Style="{StaticResource NavButtonActiveStyle}"
                        Click="BtnPage1_Click"
                        ToolTip="Перейти к Заданию 1: вычисление функции a (линейный алгоритм)"/>
                <Button x:Name="BtnNav2"
                        Content="🔀 Задание 2 — Ветвление"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnPage2_Click"
                        ToolTip="Перейти к Заданию 2: вычисление функции e (ветвление)"/>
                <Button x:Name="BtnNav3"
                        Content="🔁 Задание 3 — Цикл и график"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnPage3_Click"
                        ToolTip="Перейти к Заданию 3: табулирование функции и построение графика (цикл)"/>
                <Button Content="❌ Выход"
                        Style="{StaticResource NavButtonStyle}"
                        Background="#E88080"
                        BorderBrush="#C05050"
                        Click="BtnExit_Click"
                        Margin="30,4,4,4"
                        ToolTip="Закрыть приложение (будет запрошено подтверждение)"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="2" Background="#EEF2F8" BorderBrush="#B0C0D8" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="StatusText"
                       Text="Практическая работа №4 | Вариант 5 | Соболенко А., Новиков Д. | Группа 3ИСИП-423"
                       FontSize="11" Foreground="#607090"/>
        </Border>
    </Grid>
</Window>
