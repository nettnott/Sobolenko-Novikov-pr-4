<Page x:Class="Практическая_работа_4_Новиков_Соболенко.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задание 1 — Линейный алгоритм">
    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Foreground" Value="#304060"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#A0B0C0"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#4070C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2050A0"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Задание 1. Вычисление функции a"
                           FontSize="16" FontWeight="Bold" Foreground="#203050" Margin="0,0,0,10"
                           ToolTip="Вычисление линейной формулы для функции a по варианту 5"/>

                <Border BorderBrush="#A0B0C0" BorderThickness="1" Margin="0,0,0,14"
                        CornerRadius="4" Padding="4">
                    <Image Source="Image\1.png" Height="55" Stretch="Uniform"
                           ToolTip="Формула для вычисления функции a (Вариант 5)"/>
                </Border>

                <TextBlock Text="Введите X:" Style="{StaticResource LabelStyle}"
                           ToolTip="Переменная X — вещественное число (используется в логарифме и произведении)"/>
                <TextBox x:Name="TxtX" Style="{StaticResource InputStyle}"
                         ToolTip="Введите вещественное число X&#10;Пример: 2,5 или -1,3&#10;Примечание: разделитель — запятая"
                         TextChanged="Input_TextChanged"/>

                <TextBlock Text="Введите Y:" Style="{StaticResource LabelStyle}"
                           ToolTip="Переменная Y — вещественное число, должно быть Y ≠ 0 (присутствует в основании логарифма)"/>
                <TextBox x:Name="TxtY" Style="{StaticResource InputStyle}"
                         ToolTip="Введите вещественное число Y&#10;Внимание: Y не должно быть равно нулю!&#10;Пример: 3,0 или -2,5"
                         TextChanged="Input_TextChanged"/>

                <TextBlock Text="Введите Z:" Style="{StaticResource LabelStyle}"
                           ToolTip="Переменная Z — вещественное число (используется в функции arctan)"/>
                <TextBox x:Name="TxtZ" Style="{StaticResource InputStyle}"
                         ToolTip="Введите вещественное число Z&#10;Пример: 1,0 или 0,75"
                         TextChanged="Input_TextChanged"/>

                <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button Content="▶ Вычислить" Style="{StaticResource BtnPrimary}"
                            Click="BtnCalc_Click" Margin="0,0,10,0"
                            ToolTip="Вычислить значение функции a по введённым значениям X, Y, Z"/>
                    <Button Content="🗑 Очистить" Style="{StaticResource BtnSecondary}"
                            Click="BtnClear_Click"
                            ToolTip="Очистить все поля ввода и результат"/>
                </StackPanel>

                <TextBlock Text="Результат:" FontWeight="Bold" Foreground="#203050"
                           ToolTip="Здесь будет отображено вычисленное значение функции a"/>
                <TextBox x:Name="TxtResult"
                         IsReadOnly="True"
                         Background="#F0F4FA"
                         BorderBrush="#7090C0"
                         Padding="6,4"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="#204080"
                         ToolTip="Результат вычисления (поле только для чтения — значение вычисляется автоматически)"/>
            </StackPanel>

            <Border Grid.Column="1" Margin="20,0,0,0" BorderBrush="#C0D0E0"
                    BorderThickness="1" CornerRadius="6" Padding="14" Background="#F8FAFF"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="📌 Справка по формуле (Вариант 5)"
                               FontWeight="Bold" FontSize="13" Foreground="#203050" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#405070" FontSize="12" LineHeight="20">
                        <Run FontWeight="Bold">Функция a =</Run>
                        <Run>ln(y^(−√|x|)) · (x − y/2) + sin²(arctg(z))</Run>
                    </TextBlock>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="Ограничения:" FontWeight="Bold" Foreground="#405070" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#607090" FontSize="12" LineHeight="18">
                        • Y ≠ 0 (основание логарифма не должно быть нулём)&#10;
                        • Все поля обязательны для заполнения&#10;
                        • Используйте запятую как разделитель дробной части
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>