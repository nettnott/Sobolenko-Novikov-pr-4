<Page x:Class="Практическая_работа_4_Новиков_Соболенко.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задание 3 — Цикл и график">
    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="Foreground" Value="#304060"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#A0B0C0"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#4070C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2050A0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Задание 3. Цикл и график"
                       FontSize="15" FontWeight="Bold" Foreground="#203050" Margin="0,0,0,8"
                       ToolTip="Табулирование функции y = x⁴ + cos(2 + x³ − b) и построение графика"/>

            <Border BorderBrush="#A0B0C0" BorderThickness="1" Margin="0,0,0,10"
                    CornerRadius="4" Padding="4">
                <Image Source="Image\3.png" Height="45" Stretch="Uniform"
                       ToolTip="Формула: y = x⁴ + cos(2 + x³ − b)"/>
            </Border>

            <TextBlock Text="X начальное (x₀):" Style="{StaticResource LabelStyle}"
                       ToolTip="Начальное значение переменной X для табулирования"/>
            <TextBox x:Name="TxtX0" Style="{StaticResource InputStyle}" Text="4,6"
                     ToolTip="Начальное значение x для цикла&#10;Должно быть меньше X конечного&#10;Пример: 4,6"
                     TextChanged="Input_TextChanged"/>

            <TextBlock Text="X конечное (xk):" Style="{StaticResource LabelStyle}"
                       ToolTip="Конечное значение переменной X. Должно быть больше X начального"/>
            <TextBox x:Name="TxtXk" Style="{StaticResource InputStyle}" Text="5,8"
                     ToolTip="Конечное значение x для цикла&#10;Должно быть больше X начального&#10;Пример: 5,8"
                     TextChanged="Input_TextChanged"/>

            <TextBlock Text="Шаг dx:" Style="{StaticResource LabelStyle}"
                       ToolTip="Шаг изменения X на каждой итерации цикла. Должен быть положительным"/>
            <TextBox x:Name="TxtDx" Style="{StaticResource InputStyle}" Text="0,2"
                     ToolTip="Шаг для цикла — должен быть положительным числом&#10;Пример: 0,2 или 0,1"
                     TextChanged="Input_TextChanged"/>

            <TextBlock Text="Параметр b:" Style="{StaticResource LabelStyle}"
                       ToolTip="Параметр b в формуле y = x⁴ + cos(2 + x³ − b)"/>
            <TextBox x:Name="TxtB" Style="{StaticResource InputStyle}" Text="1,3" Margin="0,0,0,8"
                     ToolTip="Параметр b — вещественное число&#10;Влияет на сдвиг аргумента в косинусе&#10;Пример: 1,3"
                     TextChanged="Input_TextChanged"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

            <Button Content="▶ Вычислить и построить" Style="{StaticResource BtnPrimary}"
                    Click="BtnCalc_Click" Margin="0,0,0,6"
                    ToolTip="Вычислить таблицу значений и построить график функции"/>
            <Button Content="🗑 Очистить" Padding="10,6" FontSize="13" Cursor="Hand"
                    Click="BtnClear_Click" Margin="0,0,0,10"
                    ToolTip="Очистить таблицу результатов и удалить график"/>

            <TextBlock Text="Таблица значений:" FontWeight="Bold" Foreground="#203050" Margin="0,0,0,4"
                       ToolTip="Таблица рассчитанных значений x и y"/>
            <TextBox x:Name="TxtOutput"
                     Height="160" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Background="#F0F4FA"
                     BorderBrush="#7090C0"
                     Padding="5" FontFamily="Consolas" FontSize="12"
                     ToolTip="Таблица значений x и y (только для чтения — заполняется автоматически при вычислении)"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="График функции y = x⁴ + cos(2 + x³ − b)"
                       FontWeight="Bold" Foreground="#203050" Margin="0,0,0,6"
                       ToolTip="Визуальный график функции по вычисленным точкам"/>
            <Border Grid.Row="1" BorderBrush="#7090C0" BorderThickness="1"
                    ClipToBounds="True" CornerRadius="4" Background="White">
                <Canvas x:Name="GraphCanvas" Background="White"
                        ToolTip="Область построения графика. Нажмите «Вычислить и построить» для отображения"/>
            </Border>
        </Grid>
    </Grid>
</Page>
