<Page x:Class="Практическая_работа_4_Новиков_Соболенко.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задание 2 — Ветвление">
    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Foreground" Value="#304060"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#A0B0C0"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#4070C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2050A0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Задание 2. Вычисление функции e"
                           FontSize="16" FontWeight="Bold" Foreground="#203050" Margin="0,0,0,10"
                           ToolTip="Вычисление функции e с ветвлением по условию (Вариант 5)"/>

                <Border BorderBrush="#A0B0C0" BorderThickness="1" Margin="0,0,0,14"
                        CornerRadius="4" Padding="4">
                    <Image Source="Image\2.png" Height="80" Stretch="Uniform"
                           ToolTip="Формула для вычисления функции e с ветвлением (Вариант 5)"/>
                </Border>

                <TextBlock Text="Введите X:" Style="{StaticResource LabelStyle}"
                           ToolTip="Переменная X — вещественное число. Знак X определяет ветку вычисления"/>
                <TextBox x:Name="TxtX" Style="{StaticResource InputStyle}"
                         ToolTip="Введите вещественное число X&#10;Пример: 2,5 или -1,3&#10;Знак числа влияет на выбор ветки вычисления"
                         TextChanged="Input_TextChanged"/>

                <TextBlock Text="Введите i (целое число):" Style="{StaticResource LabelStyle}"
                           ToolTip="Параметр i — целое число. Чётность i определяет ветку вычисления"/>
                <TextBox x:Name="TxtI" Style="{StaticResource InputStyle}"
                         ToolTip="Введите целое число i (без дробной части)&#10;Чётность числа влияет на выбор ветки&#10;Пример: 3 или -2"
                         TextChanged="Input_TextChanged"/>

                <GroupBox Header="Выберите функцию f(x)" Margin="0,8,0,10" Padding="8"
                          ToolTip="Выберите одну из трёх функций f(x), которая будет использована в вычислении">
                    <StackPanel>
                        <RadioButton x:Name="RbSh" Content="sh(x) — гиперболический синус" IsChecked="True"
                                     Margin="0,3"
                                     ToolTip="f(x) = sh(x) = (e^x - e^(-x)) / 2 — гиперболический синус"/>
                        <RadioButton x:Name="RbSqr" Content="x² — квадрат X" Margin="0,3"
                                     ToolTip="f(x) = x² — квадрат значения X"/>
                        <RadioButton x:Name="RbExp" Content="e^x — экспонента" Margin="0,3"
                                     ToolTip="f(x) = e^x — экспоненциальная функция от X"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button Content="▶ Вычислить" Style="{StaticResource BtnPrimary}"
                            Click="BtnCalc_Click" Margin="0,0,10,0"
                            ToolTip="Вычислить значение функции e по введённым X и i, используя выбранную f(x)"/>
                    <Button Content="🗑 Очистить" Padding="18,6" FontSize="13" Cursor="Hand"
                            Click="BtnClear_Click"
                            ToolTip="Очистить поля ввода, сбросить выбор функции и результат"/>
                </StackPanel>

                <TextBlock Text="Результат:" FontWeight="Bold" Foreground="#203050"
                           ToolTip="Здесь будет отображено вычисленное значение функции e"/>
                <TextBox x:Name="TxtResult"
                         IsReadOnly="True"
                         Background="#F0F4FA"
                         BorderBrush="#7090C0"
                         Padding="6,4"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="#204080"
                         ToolTip="Результат вычисления (поле только для чтения)"/>
            </StackPanel>

            <Border Grid.Column="1" Margin="20,0,0,0" BorderBrush="#C0D0E0"
                    BorderThickness="1" CornerRadius="6" Padding="14" Background="#F8FAFF"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="📌 Справка по формуле (Вариант 5)"
                               FontWeight="Bold" FontSize="13" Foreground="#203050" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#405070" FontSize="12" LineHeight="22">
                        <Run FontWeight="Bold">Ветка 1</Run><Run> (i нечётное И x &gt; 0):</Run><LineBreak/>
                        <Run>  e = i · √f(x)</Run><LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">Ветка 2</Run><Run> (i чётное И x &lt; 0):</Run><LineBreak/>
                        <Run>  e = (i/2) · √|f(x)|</Run><LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">Иначе:</Run><LineBreak/>
                        <Run>  e = √|i · f(x)|</Run>
                    </TextBlock>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="Ограничения:" FontWeight="Bold" Foreground="#405070" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#607090" FontSize="12" LineHeight="18">
                        • Все поля обязательны для заполнения&#10;
                        • i — только целое число&#10;
                        • Разделитель дробной части — запятая
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
